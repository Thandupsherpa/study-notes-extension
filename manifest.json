{
  "manifest_version": 3,
  "name": "Digiicampus Study Assistant",
  "version": "1.0.0",
  "description": "Production-quality AI student study notes generator & PDF exporter for Digiicampus LMS.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Digiicampus Study Assistant",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "https://*.digiicampus.com/*",
    "http://*.digiicampus.com/*"
  ],
  "background": {
    "service_worker": "src/background/serviceWorker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.digiicampus.com/*",
        "http://*.digiicampus.com/*"
      ],
      "js": [
        "src/content/digiiContentScript.ts"
      ],
      "run_at": "document_idle"
    }
  ]
}
